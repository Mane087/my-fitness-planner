{
  "name": "my-fitness-planner",
  "version": "0.0.0",
  "lint-staged": {
    "*.{ts,html,css,scss,md,json}": [
      "prettier --write"
    ],
    "*.ts": [
      "eslint --max-warnings=0"
    ]
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
